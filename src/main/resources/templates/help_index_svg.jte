@for(var line : poster.customizeRows())
<text fill="#363B24" fill-opacity="${line.opacity()}" style="white-space: pre" xml:space="preserve" font-family="${line.fontFamily()}" font-size="${line.size()}" font-weight="500" letter-spacing="0em"><tspan x="${line.x()}" y="${line.y()}">${line.text()}</tspan></text>
@endfor
@for(var line : poster.preferenceRows())
<text fill="#363B24" fill-opacity="${line.opacity()}" style="white-space: pre" xml:space="preserve" font-family="${line.fontFamily()}" font-size="${line.size()}" font-weight="500" letter-spacing="0em"><tspan x="${line.x()}" y="${line.y()}">${line.text()}</tspan></text>
@endfor
@for(var line : poster.funRows())
<text fill="#363B24" fill-opacity="${line.opacity()}" style="white-space: pre" xml:space="preserve" font-family="${line.fontFamily()}" font-size="${line.size()}" font-weight="500" letter-spacing="0em"><tspan x="${line.x()}" y="${line.y()}">${line.text()}</tspan></text>
@endfor
@for(var line : poster.otherRows())
<text fill="#363B24" fill-opacity="${line.opacity()}" style="white-space: pre" xml:space="preserve" font-family="${line.fontFamily()}" font-size="${line.size()}" font-weight="500" letter-spacing="0em"><tspan x="${line.x()}" y="${line.y()}">${line.text()}</tspan></text>
@endfor
</g>

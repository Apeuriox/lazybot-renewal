<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="me.aloic.lazybot.osu.dao.mapper.TokenMapper">
    <resultMap id="BaseResultMap" type="me.aloic.lazybot.osu.dao.entity.po.AccessTokenPO">
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="qq_code" jdbcType="BIGINT" property="qq_code"/>
        <result column="player_id" jdbcType="INTEGER" property="player_id"/>
        <result column="access_token" jdbcType="VARCHAR" property="access_token"/>
        <result column="expires_in" jdbcType="INTEGER" property="expires_in"/>
        <result column="refresh_token" jdbcType="VARCHAR" property="refresh_token"/>
        <result column="player_name" jdbcType="VARCHAR" property="player_name"/>
        <result column="default_mode" jdbcType="INTEGER" property="default_mode"/>
        <result column="avatar_url" jdbcType="VARCHAR" property="avatar_url"/>
        <result column="star_moon_id" jdbcType="INTEGER" property="star_moon_id"/>
        <result column="star_moon_ruleset" jdbcType="VARCHAR" property="star_moon_ruleset"/>
        <result column="star_moon_mode" jdbcType="VARCHAR" property="star_moon_mode"/>
    </resultMap>
    <sql id = "Base_Column_List">
        id, qq_code, player_id, access_token, refresh_token, expires_in, default_mode, player_name, valid, avatar_url, star_moon_mode, star_moon_ruleset, star_moon_id
    </sql>

    <select id="selectByQq_code" parameterType="java.lang.Long" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from token
        where qq_code =#{qq_code,jdbcType=BIGINT}
    </select>

    <select id="selectByPlayername" parameterType="java.lang.String" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from token
        where player_name =#{player_name}
    </select>

    <select id="selectByPlayerId" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from token
        where player_id =#{player_id}
    </select>

    <select id="selectByStarMoonId" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from token
        where star_moon_id =#{star_moon_id}
    </select>

    <select id="selectRandom" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from token
        ORDER BY RAND()
        LIMIT 1;
    </select>

    <select id="selectDefaultModeByQq_code" parameterType="java.lang.Long" resultType="String">
        select default_mode
        from token
        where qq_code =#{qq_code,jdbcType=BIGINT}
    </select>

    <select id="selectByCodes" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from token
        where valid = 1 and qq_code in
        <foreach collection="codes" index="index" item="item" separator="," open="(" close=")">
            #{item,jdbcType=BIGINT}
        </foreach>
    </select>

    <update id="updateByToken" parameterType="me.aloic.lazybot.osu.dao.entity.po.AccessTokenPO">
        update token
        <set>
            access_token=#{access_token},
        </set>
        where qq_code =#{qq_code,jdbcType=BIGINT}
    </update>

    <update id="updateDefaultMode" parameterType="map">
        update token
        <set>
            default_mode=#{default_mode},
        </set>
        where qq_code =#{qq_code,jdbcType=BIGINT}
    </update>
    <update id="updateStarMoonMode" parameterType="map">
        update token
        <set>
            star_moon_mode=#{star_moon_mode},
        </set>
        where qq_code =#{qq_code,jdbcType=BIGINT}
    </update>
    <update id="updateStarMoonRuleset" parameterType="map">
        update token
        <set>
            star_moon_ruleset=#{star_moon_ruleset},
        </set>
        where qq_code =#{qq_code,jdbcType=BIGINT}
    </update>
    <update id="updateClientToken" parameterType="java.lang.String">
        update token
        <set>
            access_token=#{access_token},
        </set>
        where qq_code = 0
    </update>

    <update id="updateAvatar" parameterType="map">
        update token
        <set>
            avatar_url=#{avatar_url},
        </set>
        where player_id = #{player_id}
    </update>

    <delete id="deleteByQQ" parameterType="java.lang.Long">
        DELETE FROM token WHERE qq_code = #{qq_code}
    </delete>

</mapper>

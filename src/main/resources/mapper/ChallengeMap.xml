<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="me.aloic.lazybot.osu.dao.mapper.ChallengeMapMapper">
    <resultMap id="BaseResultMap" type="me.aloic.lazybot.entity.po.BadgeChallengeMapPO">
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="challenge_id" jdbcType="INTEGER" property="challenge_id"/>
        <result column="beatmap_id" jdbcType="INTEGER" property="beatmap_id"/>
        <result column="required_acc" jdbcType="DOUBLE" property="required_cacc"/>
        <result column="required_combo" jdbcType="INTEGER" property="required_combo"/>
        <result column="max_accepted_miss" jdbcType="INTEGER" property="max_accepted_miss"/>
        <result column="mods_allowed" jdbcType="VARCHAR" property="mods_allowed"/>
        <result column="mode" jdbcType="INTEGER" property="mode"/>
    </resultMap>

    <sql id = "Base_Column_List">
        id, challenge_id, beatmap_id, required_acc, required_combo, max_accepted_miss, mods_allowed, mode
    </sql>

    <select id="selectById" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM badge_challenge_map
        WHERE id =#{id}
    </select>

    <select id="selectByBeatmapIdAndChallengeId" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM badge_challenge_map
        WHERE challenge_id =#{challengeId}
        AND beatmap_id =#{beatmapId}
    </select>

    <select id="selectByChallengeId" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM badge_challenge_map
        WHERE challenge_id =#{challengeId}
    </select>



</mapper>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="me.aloic.lazybot.osu.dao.mapper.TokenStarMoonMapper">
    <resultMap id="BaseResultMap" type="me.aloic.lazybot.osu.dao.entity.po.TokenStarMoon">
        <id column="id" jdbcType="INTEGER" property="id"/>
        <result column="qq_code" jdbcType="BIGINT" property="qq_code"/>
        <result column="star_moon_id" jdbcType="INTEGER" property="star_moon_id"/>
        <result column="star_moon_name" jdbcType="VARCHAR" property="star_moon_name"/>
        <result column="create_time" jdbcType="DATE" property="create_time"/>
        <result column="default_mode" jdbcType="VARCHAR" property="default_mode"/>
        <result column="default_ruleset" jdbcType="VARCHAR" property="default_ruleset"/>
    </resultMap>
    <sql id = "Base_Column_List">
        id, qq_code, star_moon_id, star_moon_name, create_time, default_mode, default_ruleset
    </sql>

    <select id="selectByQq_code" parameterType="java.lang.Long" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from token_star_moon
        where qq_code =#{qq_code,jdbcType=BIGINT}
    </select>

    <select id="selectByPlayername" parameterType="java.lang.String" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from token_star_moon
        where player_name =#{player_name}
    </select>

    <select id="selectByPlayerId" parameterType="java.lang.Integer" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from token_star_moon
        where star_moon_id =#{player_id}
    </select>


    <select id="selectRandom" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/>
        from token_star_moon
        ORDER BY RAND()
        LIMIT 1;
    </select>

    <select id="selectDefaultModeByQq_code" parameterType="java.lang.Long" resultType="String">
        select default_mode
        from token_star_moon
        where qq_code =#{qq_code,jdbcType=BIGINT}
    </select>


    <update id="updateDefaultMode" parameterType="map">
        update token_star_moon
        <set>
            default_mode=#{default_mode},
        </set>
        where qq_code =#{qq_code,jdbcType=BIGINT}
    </update>

    <update id="updateSubRuleset" parameterType="map">
        update token_star_moon
        <set>
            default_ruleset=#{ruleset},
        </set>
        where qq_code =#{qq_code,jdbcType=BIGINT}
    </update>

    <delete id="deleteByQQ" parameterType="java.lang.Long">
        DELETE FROM token_star_moon WHERE qq_code = #{qq_code}
    </delete>

</mapper>

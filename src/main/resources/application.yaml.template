spring:
  application:
    name: lazybot-renewal
  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: $jdbc:mysql://localhost:3306/lazybot_schema
    username: root
    password: $you_database_password
    hikari:
      max-lifetime: 120000
  jackson:
    date-format: yyyy-MM-dd HH:mm:ss
    time-zone: GMT+8
  web:
    resources:
      add-mappings: false
  threads:
    virtual:
      enabled: true

server:
  port: 9001

shiro:
  ws:
    server:
      enable: true
      url: /lazybot
    timeout: 10
    max-binary-message-buffer-size: 5120000
    max-text-message-buffer-size: 512000
  limiter:
    enable: true
    rate: 10
    capacity: 30
    awaitTask: true
    timeout: 10

discord:
  bot:
    key: your_discord_bot_key
    id: your_discord_bot_id
    secret: your_discord_bot_secret
    token: your_discord_bot_token

tencent:
  bot:
    id: 1611727
    secret: your_official_tencent_bot_secret_itIsAbandoned
    token: above

lazybot:
  prefix: /
  client_id: $osu_stuff
  response_type: code
  scopes: friends.read identify public
  client_secret: $osu_stuff
  grant_type: authorization_code
  avatar-cache:
    revalidate-hours: 24
  render-cache:
    enabled: true
    max-weight-mb: 256
    expire-minutes: 30
  oauth:
    redirect-uri: https://your-domain.example/oauth/osu/callback
    scopes: identify public
  plus:
    client_id: lazybot_pp_plus_related
    client_password: lazybot_pp_plus_related
  global:
    discord:
      enabled: false
    tencent:
      enabled: true
  test:
    path: X:\lazybot-output
    identity: localTestIdentity
    enabled: true
  command:
    whatif_calc_max_count: 200
    max-pending-per-user: 16
    message-dedup-retention-seconds: 30
    message-dedup-cleanup-ms: 60000

async:
  executor:
    thread:
      core_pool_size: 5
      max_pool_size: 5
      queue_capacity: 1000
      name:
        prefix: api_request_pool-

#mybatis-plus:
#  configuration:
#    default-executor-type: REUSE
#    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl

rate-limit:
  capacity: 24
  refill: 8
  enabled: true
